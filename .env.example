# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Postgres (docker-compose) ---
POSTGRES_PORT=5435
POSTGRES_PASSWORD=change-me-bootstrap
P03_MIGRATOR_PASSWORD=change-me-migrator
P03_APP_PASSWORD=change-me-app
DATABASE_URL=postgresql://p03_app:change-me-app@127.0.0.1:5435/p03
MIGRATOR_DATABASE_URL=postgresql://p03_migrator:change-me-migrator@127.0.0.1:5435/p03

# --- Safety ---
DRY_RUN=true                # outbound messages and calendar/CRM writes are logged, not performed
PHONE_HASH_KEY=change-me-long-random-string   # HMAC key: phone numbers in logs/thread ids

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM (task 0.4: a NEW key for P03, in a Console workspace with its own spend limit) ---
ANTHROPIC_API_KEY=

# --- Langfuse (task 0.4: a new project "p03-ai-operations-agent") ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Telegram owner bot (task 3.2: create the bot with @BotFather; get your id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_LIVE=false

# --- Real integrations (Phase 4). Defaults are fakes; switch on ONE at a time, DRY_RUN stays true until you say so ---
CALENDAR_BACKEND=fake            # fake | google
GOOGLE_CALENDAR_ID=              # the TEST calendar id
GOOGLE_CREDENTIALS_FILE=         # path to the service-account JSON (keep it outside the repo)
CRM_BACKEND=fake                 # fake | hubspot
HUBSPOT_TOKEN=                   # private-app token
TWILIO_LIVE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=            # sandbox number
TWILIO_ALLOWED_TO=               # comma-separated; your own verified phone only

# Personal terms the secrets scan must never find in the repo (your email name, your phone number...), comma separated
SCAN_EXTRA_TERMS=

TWILIO_WHATSAPP_CONTENT_SID=   # sandbox template (HX...), only if free text is refused with error 21654
